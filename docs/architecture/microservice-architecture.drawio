        <mxCell id="t2note" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;verticalAlign=middle;align=left;spacingLeft=12;fontSize=11;" value="&lt;b&gt;Operations&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;- on&lt;/b&gt; = runs when the service consumes that Kafka event;&amp;nbsp;&amp;nbsp;&lt;b&gt;- scheduled&lt;/b&gt; = the service's own timer;&amp;nbsp;&amp;nbsp;&lt;b&gt;- gRPC&lt;/b&gt; = internal call with no public route.&lt;br&gt;&lt;b&gt;Collaborators&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&amp;gt;&lt;/b&gt; = operation called, or event published or consumed;&amp;nbsp;&amp;nbsp;(name) = the service at the other end.&amp;nbsp;&amp;nbsp;The API Gateway rejects requests without a valid JWT; each service authorizes by role and ownership (ADR-003), so no service calls Identity to check permissions." vertex="1">
          <mxGeometry x="60" y="1598" width="1520" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
