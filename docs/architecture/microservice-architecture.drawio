        <mxCell id="c7_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#8FA8BC;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fillColor=#FFFFFF;" value="&lt;font color='#23445D'&gt;&lt;b&gt;1.&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Email Provider&lt;/b&gt; (Email Adapter)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;sendEmail()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;2.&lt;/b&gt;&lt;/font&gt; &lt;b&gt;Event Broker (Kafka)&lt;/b&gt;&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;ContactChanged&lt;/b&gt;&lt;/font&gt; (Identity)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;BuddyRequestSent&lt;/b&gt;&lt;/font&gt; (Buddy Discovery)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;BuddyRequestAnswered&lt;/b&gt;&lt;/font&gt; (Buddy Discovery)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;RunScheduled&lt;/b&gt;&lt;/font&gt; (Run Scheduling)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;RunChanged&lt;/b&gt;&lt;/font&gt; (Run Scheduling)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;RunCancelled&lt;/b&gt;&lt;/font&gt; (Run Scheduling)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;ReminderDue&lt;/b&gt;&lt;/font&gt; (Run Scheduling)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;ForecastChanged&lt;/b&gt;&lt;/font&gt; (Run Scheduling)&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;&amp;gt;&lt;/b&gt;&lt;/font&gt; consume &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;AttendanceOpened&lt;/b&gt;&lt;/font&gt; (Reputation)" vertex="1">
