  <diagram id="table" name="Service-Operations-Collaborators">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1640" pageHeight="1690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#23445D;" value="Can't Run Alone  -  Service / Operations / Collaborators" vertex="1">
          <mxGeometry height="36" width="1000" x="60" y="22" as="geometry" />
        </mxCell>
        <mxCell id="t2s" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#666666;" value="This table, the diagram on page 1, and the context map on page 3 agree: every service in one appears in the others. Rows run core first, then supporting, then generic." vertex="1">
          <mxGeometry height="34" width="1520" x="60" y="58" as="geometry" />
        </mxCell>
        <mxCell id="uc0" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B6DFD4;strokeColor=#2C5F52;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;Business Use Case 1&lt;/b&gt;&lt;br&gt;&lt;b&gt;UC-02 Find a Compatible Running Buddy&lt;/b&gt;&lt;br&gt;Find runners who match their pace, area, and free time, and send one a buddy request&lt;br&gt;&lt;i&gt;Primary actor: Runner&lt;/i&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#1D4A3F'&gt;Services: Buddy Discovery, Profile, Trust &amp;amp; Safety, Reputation, Notification&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="96" width="493" height="124" as="geometry" />
        </mxCell>
        <mxCell id="uc1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B6DFD4;strokeColor=#2C5F52;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;Business Use Case 2&lt;/b&gt;&lt;br&gt;&lt;b&gt;UC-03 Schedule a Run with Weather Check and Pinned Meeting Point&lt;/b&gt;&lt;br&gt;Fix a time, a public meeting point, and a pace, see whether the weather and PM2.5 are safe, and get people to join&lt;br&gt;&lt;i&gt;Primary actor: Organizer&lt;/i&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#1D4A3F'&gt;Services: Run Scheduling, Run Conditions, Buddy Discovery, Trust &amp;amp; Safety, Notification, Map Provider&lt;/span&gt;" vertex="1">
          <mxGeometry x="573" y="96" width="493" height="124" as="geometry" />
        </mxCell>
        <mxCell id="uc2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#B6DFD4;strokeColor=#2C5F52;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="&lt;b&gt;Business Use Case 3&lt;/b&gt;&lt;br&gt;&lt;b&gt;UC-04 Confirm Attendance, Rate Buddies, and Log Running Record&lt;/b&gt;&lt;br&gt;Get credit for a run they actually attended, rate the people they ran with, and log distance and time&lt;br&gt;&lt;i&gt;Primary actor: Participant&lt;/i&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#1D4A3F'&gt;Services: Run Scheduling, Reputation, Buddy Discovery, Trust &amp;amp; Safety, Notification&lt;/span&gt;" vertex="1">
          <mxGeometry x="1086" y="96" width="493" height="124" as="geometry" />
        </mxCell>
        <mxCell id="h-service" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#23445D;strokeColor=#23445D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="Service" vertex="1">
          <mxGeometry x="60" y="240" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h-operations" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#23445D;strokeColor=#23445D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="Operations" vertex="1">
