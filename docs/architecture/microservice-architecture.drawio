        </mxCell>
        <mxCell id="c0_0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#8FA8BC;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fillColor=#EAF3FA;" value="&lt;span style='font-size:16px'&gt;&lt;b&gt;Buddy Discovery Service&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#B85450'&gt;&lt;b&gt;Core subdomain&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#444444'&gt;&lt;i&gt;Data: Discovery DB (PostgreSQL + PostGIS)&lt;/i&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="284" width="290" height="166" as="geometry" />
        </mxCell>
        <mxCell id="c0_1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#8FA8BC;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fillColor=#FFFFFF;" value="&lt;font color='#23445D'&gt;&lt;b&gt;1.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;searchRunners()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;2.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;sendBuddyRequest()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;3.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;getBuddyRequests()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;4.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;respondToBuddyRequest()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;5.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;listBuddies()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;6.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;blockRunner()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;7.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;expireBuddyRequests()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;-&lt;/b&gt;&lt;/font&gt; scheduled&lt;br&gt;&lt;font color='#23445D'&gt;&lt;b&gt;8.&lt;/b&gt;&lt;/font&gt; &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;updateCandidate()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;emsp;&lt;font color='#C8943F'&gt;&lt;b&gt;-&lt;/b&gt;&lt;/font&gt; on &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;ProfileUpdated&lt;/b&gt;&lt;/font&gt;, &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;RunnerVerified&lt;/b&gt;&lt;/font&gt;, &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;VerificationRejected&lt;/b&gt;&lt;/font&gt;, &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;AccountSuspended&lt;/b&gt;&lt;/font&gt;, &lt;font face='Courier New' color='#1F3B57'&gt;&lt;b&gt;RatingUpdated&lt;/b&gt;&lt;/font&gt;" vertex="1">
