        <mxCell id="cm-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#23445D;" value="Can't Run Alone  -  Context Map" vertex="1">
          <mxGeometry x="60" y="16" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cm-sub" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" value="Each box is one bounded context, built as one service. Lines are relationships between models, not calls: &lt;b&gt;U&lt;/b&gt; = upstream, supplies the model; &lt;b&gt;D&lt;/b&gt; = downstream, adapts to it. Internal relationships run over Kafka events unless a line says gRPC." vertex="1">
          <mxGeometry x="60" y="54" width="1280" height="36" as="geometry" />
        </mxCell>
