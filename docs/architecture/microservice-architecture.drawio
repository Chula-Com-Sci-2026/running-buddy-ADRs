        <mxCell id="h-collaborators" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#23445D;strokeColor=#23445D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="Collaborators" vertex="1">
